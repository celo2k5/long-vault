# Server-only values. Live trading is disabled by default.
# Railway: set these in Variables. Attach a volume at /data for persistence.
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://longcoin.lol
DATA_DIR=/data
# Railway supplies PORT automatically.
KEEPER_SECRET=
VAULT_OWNER_ID=
KEEPER_BASE_URL=http://localhost:5173
KEEPER_INTERVAL_MS=15000
# Mainnet RPC and API settings. Never expose through NEXT_PUBLIC.
SOLANA_RPC_URL=
JUPITER_API_URL=https://perps-api.jup.ag/v2
# Required for automatic USDC-to-token buybacks via api.jup.ag.
JUPITER_API_KEY=
# Server-only developer wallet: base58 64-byte key or JSON array.
# Never use NEXT_PUBLIC or VITE prefixes for this secret.
DEV_WALLET_PRIVATE_KEY=

# Explicit live-order opt-in. Also enable orders in authenticated Admin.
LIVE_TRADING_ENABLED=false

# Optional: base64-encoded 32-byte encryption key stored in Railway Variables.
# If omitted, a private key file is created on DATA_DIR when saving a wallet.
WALLET_ENCRYPTION_KEY=
