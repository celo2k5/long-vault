# Server-only values. No signing or broadcasting is enabled.
# Railway: set these in Variables. Attach a volume at /data for persistence.
ADMIN_PASSWORD=
PUBLIC_ORIGIN=https://longcoin.lol
DATA_DIR=/data
# Railway supplies PORT automatically.
TRADING_MODE=mock
KEEPER_SECRET=
VAULT_OWNER_ID=
KEEPER_BASE_URL=http://localhost:5173
KEEPER_INTERVAL_MS=15000
# Mainnet reads and unsigned previews. Never expose through NEXT_PUBLIC.
SOLANA_RPC_URL=
JUPITER_API_URL=https://perps-api.jup.ag/v2
JUPITER_API_KEY=
# Reserved, not used: signing has not been implemented.
SIGNER_KEY_REFERENCE=
